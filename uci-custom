#!/bin/sh

# --- 变量定义 ---
root_password="zds13938431145"
lan_ip_address="192.168.5.1"
pppoe_username="037107989306"
pppoe_password="410104"

wlan_name="ImmortalWrt"
wlan_password="12345678"

ttyd_auto_login="/bin/login -f root"

# 日志记录
exec >/tmp/setup.log 2>&1

# 1. 设置 Root 密码
if [ -n "$root_password" ]; then
  (echo "$root_password"; sleep 1; echo "$root_password") | passwd > /dev/null
fi

# 2. 网络原子化配置 (LAN/WAN)
uci -q batch <<EOF
  # --- LAN (Bridge模式) ---
  delete network.lan_dev
  set network.lan_dev=device
  set network.lan_dev.name='br-lan'
  set network.lan_dev.type='bridge'
  add_list network.lan_dev.ports='eth0'

  set network.lan=interface
  set network.lan.proto='static'
  set network.lan.device='br-lan'
  set network.lan.ipaddr='$lan_ip_address'
  set network.lan.netmask='255.255.255.0'
  set network.lan.delegate='0'

  # --- WAN (PPPoE) ---
  delete network.wan
  set network.wan=interface
  set network.wan.proto='pppoe'
  set network.wan.device='eth1'
  set network.wan.username='$pppoe_username'
  set network.wan.password='$pppoe_password'
  set network.wan.ipv6='auto'

  # --- ttyd 配置 ---
  $(uci -q get ttyd.@ttyd[0] >/dev/null && echo "set ttyd.@ttyd[0].command='$ttyd_auto_login'")

  commit network
  $(uci -q get ttyd.@ttyd[0] >/dev/null && echo "commit ttyd")
EOF

# 3. WiFi 动态探测与配置
# 只有当系统识别到无线物理设备 (radio0) 时才执行配置
if uci -q get wireless.radio0 > /dev/null; then
    echo "Wireless hardware detected, configuring WiFi..."
    uci -q batch <<EOF
      set wireless.radio0.disabled='0'
      set wireless.radio0.cell_density='0'

      # 配置第一个无线接口
      set wireless.default_radio0=wifi-iface
      set wireless.default_radio0.device='radio0'
      set wireless.default_radio0.network='lan'
      set wireless.default_radio0.mode='ap'
      set wireless.default_radio0.ssid='$wlan_name'
      set wireless.default_radio0.encryption='psk2'
      set wireless.default_radio0.key='$wlan_password'

      commit wireless
EOF
    # 强制重新加载无线以生效
    wifi up
else
    echo "No wireless hardware (radio0) found, skipping WiFi config."
fi

# 4. 智能 Shell 切换
if [ -x "/bin/bash" ]; then
  sed -i 's|/bin/ash|/bin/bash|g' /etc/passwd
fi

echo "All professional settings finished!"
exit 0